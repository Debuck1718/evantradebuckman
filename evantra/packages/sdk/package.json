  "description": "Official Evantra Identity SDK — OAuth 2.0 Authorization Code flow with PKCE and Evantra Workspace types.",
  "keywords": [
    "evantra",
    "identity",
    "oauth2",
    "oidc",
    "openid",
    "pkce",
    "sdk",
    "authentication",
    "single-sign-on",
    "sign-in-with-evantra"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Debuck1718/evantradebuckman/tree/main/evantra/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debuck1718/evantradebuckman.git",
    "directory": "evantra/packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Debuck1718/evantradebuckman/issues"
  },
  "author": {
    "name": "Evantra De-Buckman Ventures",
    "url": "https://evantradebuckman.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
